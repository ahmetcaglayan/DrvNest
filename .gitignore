# =============================================================================
#  Explicitly tracked
#
#  Screenshots are part of the documentation and must be committed. Listed here
#  so a future "ignore all images" rule cannot quietly drop them from the repo.
# =============================================================================
!assets/
!assets/screenshots/
!assets/screenshots/*.png
!assets/**/*.ico
