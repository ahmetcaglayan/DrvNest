<UserControl x:Class="Hexnest.App.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="clr-namespace:Hexnest.App.Services"
             xmlns:vm="clr-namespace:Hexnest.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:QueueViewModel}"
             d:DesignWidth="900">

    <Grid Margin="22,10,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================ HEADER -->
        <Grid Grid.Row="0" Margin="0,10,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{s:Loc queue.title}" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{s:Loc queue.subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Primary}"
                        Content="{s:Loc queue.continue}"
                        Command="{Binding ContinueCommand}"
                        Margin="0,0,8,0"
                        Visibility="{Binding HasPendingSession,
                                    Converter={StaticResource BoolToVisibility}}" />

                <Button Style="{StaticResource Btn.Secondary}"
                        Padding="12,7"
                        Content="{s:Loc queue.retryFailed}"
                        Command="{Binding RetryFailedCommand}"
                        Margin="0,0,8,0"
                        Visibility="{Binding FailedCount,
                                    Converter={StaticResource EmptyToVisibility}}" />

                <Button Style="{StaticResource Btn.Danger}"
                        Padding="12,7"
                        Content="{s:Loc queue.cancelAll}"
                        Command="{Binding CancelAllCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- ============================================ OVERALL PROGRESS -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,0,0,12"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility},
                            ConverterParameter=invert}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{s:Loc queue.overall}"
                               Style="{StaticResource Text.Body}"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressText}"
                               Style="{StaticResource Text.Mono}" />
                </Grid>

                <ProgressBar Style="{StaticResource Progress.Thick}"
                             Margin="0,11,0,0"
                             Minimum="0" Maximum="100"
                             Value="{Binding OverallPercent, Mode=OneWay}" />

                <TextBlock Text="{s:Loc queue.parallelNote}"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding Summary}"
                           Style="{StaticResource Text.Body}"
                           Margin="0,10,0,0"
                           Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- ============================================ RESTART PROMPT -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Background="{DynamicResource Brush.InfoSoft}"
                BorderBrush="{DynamicResource Brush.Info}"
                Padding="16,14"
                Margin="0,0,0,12"
                Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{StaticResource Icon.Power}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="19"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Info}" />

                <StackPanel Grid.Column="1" Margin="13,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="{s:Loc queue.rebootNeeded}"
                               Style="{StaticResource Text.Body}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{s:Loc queue.willResume}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Primary}"
                            Content="{s:Loc queue.rebootNow}"
                            Command="{Binding RestartNowCommand}" />

                    <Button Style="{StaticResource Btn.Ghost}"
                            Margin="8,0,0,0"
                            Content="{s:Loc queue.cancelRestart}"
                            Command="{Binding CancelRestartCommand}"
                            Visibility="{Binding RestartScheduled,
                                        Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ JOB LIST -->
        <Grid Grid.Row="3">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{StaticResource Icon.Pending}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="38"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextFaint}" />
                <TextBlock Text="{s:Loc queue.empty}"
                           Style="{StaticResource Text.Body}"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{s:Loc queue.emptyHint}"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Jobs}"
                     Style="{StaticResource List.Plain}"
                     ItemContainerStyle="{StaticResource List.Row}"
                     Padding="0,0,8,16"
                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility},
                                 ConverterParameter=invert}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Title row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0"
                                         Width="9" Height="9"
                                         VerticalAlignment="Center"
                                         Fill="{Binding State, Converter={StaticResource JobStateToBrush}}" />

                                <StackPanel Grid.Column="1" Margin="11,0,14,0">
                                    <TextBlock Text="{Binding Candidate.DeviceName}"
                                               Style="{StaticResource Text.Body}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Candidate.Title}"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Style="{StaticResource Badge}"
                                        Background="{DynamicResource Brush.SurfaceHover}">
                                    <TextBlock Text="{Binding State, Converter={StaticResource JobStateToText}}"
                                               Style="{StaticResource Badge.Text}"
                                               Foreground="{Binding State,
                                                           Converter={StaticResource JobStateToBrush}}" />
                                </Border>
                            </Grid>

                            <!-- Progress row -->
                            <ProgressBar Grid.Row="1"
                                         Style="{StaticResource Progress.Bar}"
                                         Margin="20,11,0,0"
                                         Minimum="0" Maximum="100"
                                         Foreground="{Binding State, Converter={StaticResource JobStateToBrush}}"
                                         Value="{Binding OverallPercent, Mode=OneWay}" />

                            <!-- Detail row -->
                            <Grid Grid.Row="2" Margin="20,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Mono}" />
                                    <TextBlock Text="  ·  " Style="{StaticResource Text.Mono}"
                                               Visibility="{Binding BytesTotal,
                                                           Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBlock Text="{Binding TransferDisplay}"
                                               Style="{StaticResource Text.Mono}"
                                               Visibility="{Binding BytesTotal,
                                                           Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBlock Text="  ·  " Style="{StaticResource Text.Mono}"
                                               Visibility="{Binding SpeedBytesPerSecond,
                                                           Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBlock Text="{Binding SpeedDisplay}"
                                               Style="{StaticResource Text.Mono}"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               Visibility="{Binding SpeedBytesPerSecond,
                                                           Converter={StaticResource EmptyToVisibility}}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Candidate.VersionTransition}"
                                           Style="{StaticResource Text.Mono}" />
                            </Grid>

                            <!-- Error, only when there is one -->
                            <TextBlock Grid.Row="2"
                                       Text="{Binding ErrorMessage}"
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Danger}"
                                       Margin="20,30,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ErrorMessage,
                                                   Converter={StaticResource NullToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
