<UserControl x:Class="Hexnest.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="clr-namespace:Hexnest.App.Services"
             xmlns:vm="clr-namespace:Hexnest.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
             d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,10,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================ HEADER -->
        <Grid Grid.Row="0" Margin="0,10,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{s:Loc hist.title}" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{s:Loc hist.subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Secondary}"
                        Padding="12,7"
                        Content="{s:Loc hist.exportCsv}"
                        Command="{Binding ExportCommand}" />

                <Button Style="{StaticResource Btn.Ghost}"
                        Padding="12,7"
                        Margin="8,0,0,0"
                        Foreground="{DynamicResource Brush.Danger}"
                        Content="{s:Loc hist.clear}"
                        Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>

        <!-- ============================================ FILTER BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <RadioButton Style="{StaticResource FilterChip}"
                             GroupName="HistoryFilter"
                             Content="{s:Loc hist.filterAll}"
                             IsChecked="{Binding IsAll, Mode=OneWay}"
                             Command="{Binding SetOutcomeCommand}" />

                <RadioButton Style="{StaticResource FilterChip}"
                             GroupName="HistoryFilter"
                             Content="{s:Loc hist.success}"
                             IsChecked="{Binding IsSuccess, Mode=OneWay}"
                             Command="{Binding SetOutcomeCommand}"
                             CommandParameter="Success" />

                <RadioButton Style="{StaticResource FilterChip}"
                             GroupName="HistoryFilter"
                             Content="{s:Loc hist.failed}"
                             IsChecked="{Binding IsFailed, Mode=OneWay}"
                             Command="{Binding SetOutcomeCommand}"
                             CommandParameter="Failed" />
            </StackPanel>

            <TextBox Grid.Column="1"
                     Style="{StaticResource Input.TextBox}"
                     Width="280"
                     HorizontalAlignment="Right"
                     Margin="0,0,12,0"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                     Tag="{s:Loc common.search}"
                     ToolTip="{s:Loc common.search}" />

            <TextBlock Grid.Column="2"
                       Text="{Binding CountText}"
                       Style="{StaticResource Text.Mono}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- ============================================ NOTICE -->
        <Border Grid.Row="2"
                Style="{StaticResource Card.Flat}"
                Padding="13,10"
                Margin="0,0,0,12"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Notice}"
                       Style="{StaticResource Text.Mono}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- ============================================ LIST -->
        <Grid Grid.Row="3">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{StaticResource Icon.History}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="38"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextFaint}" />
                <TextBlock Text="{s:Loc hist.empty}"
                           Style="{StaticResource Text.Body}"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <ListBox ItemsSource="{Binding View}"
                     Style="{StaticResource List.Plain}"
                     ItemContainerStyle="{StaticResource List.Row}"
                     Padding="0,0,8,16"
                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility},
                                 ConverterParameter=invert}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0"
                                     Width="9" Height="9"
                                     VerticalAlignment="Top"
                                     Margin="0,6,0,0"
                                     Fill="{Binding Outcome, Converter={StaticResource OutcomeToBrush}}" />

                            <StackPanel Grid.Column="1" Margin="12,0,14,0">
                                <TextBlock Text="{Binding DeviceName}"
                                           Style="{StaticResource Text.Body}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding VersionTransition}"
                                               Style="{StaticResource Text.Mono}"
                                               Foreground="{Binding Outcome,
                                                           Converter={StaticResource OutcomeToBrush}}" />
                                    <TextBlock Text="  ·  " Style="{StaticResource Text.Mono}" />
                                    <TextBlock Text="{Binding Provider}" Style="{StaticResource Text.Mono}" />
                                </StackPanel>

                                <TextBlock Text="{Binding ErrorMessage}"
                                           Style="{StaticResource Text.Caption}"
                                           Foreground="{DynamicResource Brush.Danger}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ErrorMessage,
                                                       Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TimestampLocal, StringFormat=yyyy-MM-dd HH:mm}"
                                           Style="{StaticResource Text.Mono}"
                                           HorizontalAlignment="Right" />

                                <Button Style="{StaticResource Btn.Ghost}"
                                        Padding="6,4"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Right"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="12"
                                        Content="{StaticResource Icon.Undo}"
                                        ToolTip="{s:Loc hist.openBackup}"
                                        Command="{Binding DataContext.OpenBackupCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanRollback,
                                                    Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
