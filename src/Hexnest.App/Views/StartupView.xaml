<UserControl x:Class="Hexnest.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="clr-namespace:Hexnest.App.Services"
             xmlns:vm="clr-namespace:Hexnest.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StartupViewModel}"
             d:DesignWidth="960">

    <UserControl.Resources>

        <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="StartupFilter" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="{StaticResource Corner.Pill}"
                                Padding="12,5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="22,10,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================ HEADER -->
        <Grid Grid.Row="0" Margin="0,10,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{s:Loc startup.title}" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{s:Loc startup.subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SummaryDisplay}"
                           Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />

                <Button Style="{StaticResource Btn.Secondary}"
                        Padding="13,7"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Refresh}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{s:Loc common.refresh}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Btn.Ghost}"
                        Padding="12,7"
                        Margin="8,0,0,0"
                        Content="{s:Loc mon.taskManager}"
                        Command="{Binding OpenTaskManagerCommand}" />
            </StackPanel>
        </Grid>

        <!-- ============================================ EXPLANATION -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Background="{DynamicResource Brush.InfoSoft}"
                BorderBrush="{DynamicResource Brush.Info}"
                Padding="16,13"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{StaticResource Icon.Info}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           VerticalAlignment="Top"
                           Margin="0,1,0,0"
                           Foreground="{DynamicResource Brush.Info}" />

                <TextBlock Grid.Column="1"
                           Text="{s:Loc startup.explain}"
                           Style="{StaticResource Text.Body}"
                           Margin="11,0,0,0"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- ============================================ BROKEN BANNER -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Background="{DynamicResource Brush.WarningSoft}"
                BorderBrush="{DynamicResource Brush.Warning}"
                Padding="16,13"
                Margin="0,0,0,14"
                Visibility="{Binding HasBroken, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{StaticResource Icon.Warning}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           VerticalAlignment="Top"
                           Margin="0,1,0,0"
                           Foreground="{DynamicResource Brush.Warning}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding BrokenDisplay}"
                           Style="{StaticResource Text.Body}"
                           Margin="11,0,0,0"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- ============================================ TOOLBAR -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource FilterTab}"
                             Content="{s:Loc common.all}"
                             IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                             Command="{Binding FilterCommand}" CommandParameter="All" />

                <RadioButton Style="{StaticResource FilterTab}"
                             Content="{s:Loc startup.filterEnabled}"
                             IsChecked="{Binding IsFilterEnabled, Mode=OneWay}"
                             Command="{Binding FilterCommand}" CommandParameter="Enabled" />

                <RadioButton Style="{StaticResource FilterTab}"
                             Content="{s:Loc startup.filterDisabled}"
                             IsChecked="{Binding IsFilterDisabled, Mode=OneWay}"
                             Command="{Binding FilterCommand}" CommandParameter="Disabled" />

                <RadioButton Style="{StaticResource FilterTab}"
                             Content="{s:Loc startup.filterBroken}"
                             IsChecked="{Binding IsFilterBroken, Mode=OneWay}"
                             Command="{Binding FilterCommand}" CommandParameter="Broken" />

                <TextBlock Text="{Binding RowCountDisplay}"
                           Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="12,1,0,0" />
            </StackPanel>

            <TextBox Grid.Column="1"
                     Style="{StaticResource Input.TextBox}"
                     Width="220"
                     Tag="{s:Loc common.search}"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
        </Grid>

        <!-- ============================================ TABLE -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" MinWidth="170" />
                        <ColumnDefinition Width="180" />
                        <!-- "Registry, all users (32-bit)" is the longest label here, and
                             it is longer still in Russian and Hindi. -->
                        <ColumnDefinition Width="215" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="86" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{s:Loc startup.onOff}" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="1" Text="{s:Loc startup.program}" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="2" Text="{s:Loc common.manufacturer}" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="3" Text="{s:Loc startup.location}" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="4" Text="{s:Loc common.size}" Style="{StaticResource ColumnHeader}"
                               TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="{s:Loc startup.actions}" Style="{StaticResource ColumnHeader}"
                               TextAlignment="Right" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Divider}" Margin="16,0" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,9" ToolTip="{Binding Tooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" MinWidth="170" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="215" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>

                                        <ToggleButton Grid.Column="0"
                                                      Style="{StaticResource Input.Switch}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsEnabled="{Binding CanToggle}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" />

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Cell}" />

                                                <Border Style="{StaticResource Badge}"
                                                        Margin="8,0,0,0"
                                                        Background="{DynamicResource Brush.DangerSoft}"
                                                        Visibility="{Binding IsSecurity,
                                                                    Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding CautionLabel}"
                                                               Style="{StaticResource Badge.Text}"
                                                               Foreground="{DynamicResource Brush.Danger}" />
                                                </Border>

                                                <Border Style="{StaticResource Badge}"
                                                        Margin="8,0,0,0"
                                                        Background="{DynamicResource Brush.WarningSoft}"
                                                        Visibility="{Binding IsBroken,
                                                                    Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{s:Loc startup.broken}"
                                                               Style="{StaticResource Badge.Text}"
                                                               Foreground="{DynamicResource Brush.Warning}" />
                                                </Border>

                                                <Border Style="{StaticResource Badge}"
                                                        Margin="8,0,0,0"
                                                        Background="{DynamicResource Brush.SurfaceHover}"
                                                        Visibility="{Binding IsRunOnce,
                                                                    Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{s:Loc startup.runOnce}"
                                                               Style="{StaticResource Badge.Text}"
                                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Command}"
                                                       Style="{StaticResource Text.Caption}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Publisher}"
                                                   Style="{StaticResource Cell}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Margin="0,0,12,0" />

                                        <TextBlock Grid.Column="3" Text="{Binding LocationDisplay}"
                                                   Style="{StaticResource Cell}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Margin="0,0,12,0" />

                                        <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}"
                                                   Style="{StaticResource Text.Mono}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Btn.Ghost}"
                                                    Padding="8,4"
                                                    ToolTip="{s:Loc startup.openLocation}"
                                                    Content="{StaticResource Icon.Folder}"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="13"
                                                    Command="{Binding DataContext.OpenLocationCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Style="{StaticResource Btn.Ghost}"
                                                    Padding="8,4"
                                                    Margin="4,0,0,0"
                                                    ToolTip="{s:Loc common.copy}"
                                                    Content="{StaticResource Icon.Copy}"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="13"
                                                    Command="{Binding DataContext.CopyCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============================================ NOTICE -->
        <TextBlock Grid.Row="5"
                   Text="{Binding Notice}"
                   Style="{StaticResource Text.Muted}"
                   TextWrapping="Wrap"
                   Margin="2,0,0,14"
                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
