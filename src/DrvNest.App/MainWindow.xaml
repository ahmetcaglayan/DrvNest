<Window x:Class="DrvNest.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:s="clr-namespace:DrvNest.App.Services"
        xmlns:vm="clr-namespace:DrvNest.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="DrvNest"
        Width="1240" Height="820"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Brush.Window}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
        WindowChrome keeps the real window behaviours - snap layouts, Aero snap,
        double click to maximise, correct taskbar interaction - while letting the
        title bar be drawn by the application. A WS_POPUP style window would lose
        all of that.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="LayoutRoot" Background="{DynamicResource Brush.Window}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================================================== SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.SidebarGradient}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Margin="20,20,20,18" Orientation="Horizontal">
                        <Border Width="34" Height="34"
                                CornerRadius="9"
                                Background="{DynamicResource Brush.Accent}"
                                VerticalAlignment="Center">
                            <TextBlock Text="D"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.AccentText}" />
                        </Border>

                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DrvNest" Style="{StaticResource Text.H2}" />
                            <TextBlock Text="{Binding VersionDisplay}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Menu. Adding an entry to MainViewModel.BuildNavigation is enough. -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource NavItem}"
                                                 GroupName="DrvNestNavigation"
                                                 Tag="{Binding Glyph}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 Command="{Binding DataContext.NavigateCommand,
                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Border Grid.Column="1"
                                                    Style="{StaticResource Badge}"
                                                    Background="{DynamicResource Brush.AccentSoft}"
                                                    Visibility="{Binding HasBadge,
                                                                Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding BadgeCount}"
                                                           Style="{StaticResource Badge.Text}"
                                                           Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                        </Grid>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer: elevation state and machine identity -->
                    <StackPanel Grid.Row="2" Margin="20,0,20,18">
                        <Border Style="{StaticResource Divider}" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Shield}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Success}" />

                            <TextBlock Text="{Binding ElevationText}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding MachineSummary}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,7,0,0"
                                   TextWrapping="Wrap"
                                   MaxHeight="46" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================================================== CONTENT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="22,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNav.Label}"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource Btn.Caption}"
                                Content="{StaticResource Icon.Minimize}"
                                Click="OnMinimize"
                                ToolTip="{s:Loc win.minimize}" />

                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource Btn.Caption}"
                                Content="{StaticResource Icon.Maximize}"
                                Click="OnMaximizeRestore"
                                ToolTip="{s:Loc win.maximize}" />

                        <Button x:Name="CloseButton"
                                Style="{StaticResource Btn.Caption}"
                                Content="{StaticResource Icon.Close}"
                                Click="OnClose"
                                ToolTip="{s:Loc common.close}" />
                    </StackPanel>
                </Grid>

                <!-- Page host -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

                <!-- Status bar -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Brush.Sidebar}"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="22,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            Real progress where it exists, an animated bar where it does
                            not. The percentage is only shown while the bar is meaningful,
                            so the user is never given a number that was invented.
                        -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0"
                                    Visibility="{Binding IsScanning,
                                                Converter={StaticResource BoolToVisibility}}">

                            <ProgressBar Width="150"
                                         Height="5"
                                         Minimum="0" Maximum="100"
                                         Style="{StaticResource Progress.Bar}"
                                         VerticalAlignment="Center"
                                         IsIndeterminate="{Binding IsScanIndeterminate}"
                                         Value="{Binding ScanPercent, Mode=OneWay}" />

                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Margin="9,0,0,0"
                                       MinWidth="34"
                                       VerticalAlignment="Center"
                                       Text="{Binding ScanPercent, StringFormat={}{0:0}%}"
                                       Visibility="{Binding IsScanIndeterminate,
                                                   Converter={StaticResource BoolToVisibility},
                                                   ConverterParameter=invert}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <Button Grid.Column="2"
                                Style="{StaticResource Btn.Ghost}"
                                Padding="10,4"
                                Content="{Binding Source=common.cancel, Converter={StaticResource Localize}}"
                                Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning,
                                            Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
