<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark palette.

        Every key here also exists in Palette.Light.xaml with the same name, so the
        two dictionaries are interchangeable at runtime and no control style ever
        needs to know which theme is active.
    -->

    <!-- Surfaces, from furthest back to closest to the user -->
    <Color x:Key="Color.Window">#0D1014</Color>
    <Color x:Key="Color.Sidebar">#12161C</Color>
    <Color x:Key="Color.Surface">#171C23</Color>
    <Color x:Key="Color.SurfaceAlt">#1E242D</Color>
    <Color x:Key="Color.SurfaceHover">#242C36</Color>
    <Color x:Key="Color.Border">#2A323D</Color>
    <Color x:Key="Color.BorderSubtle">#1F262F</Color>

    <!-- Text -->
    <Color x:Key="Color.Text">#E8EDF4</Color>
    <Color x:Key="Color.TextMuted">#94A3B4</Color>
    <Color x:Key="Color.TextFaint">#5E6B7A</Color>

    <!-- Brand and semantics -->
    <Color x:Key="Color.Accent">#35D8A4</Color>
    <Color x:Key="Color.AccentHover">#4BE7B5</Color>
    <Color x:Key="Color.AccentPressed">#22B98A</Color>
    <Color x:Key="Color.AccentText">#06231A</Color>
    <Color x:Key="Color.Info">#4C8DFF</Color>
    <Color x:Key="Color.Success">#35D8A4</Color>
    <Color x:Key="Color.Warning">#F5A623</Color>
    <Color x:Key="Color.Danger">#FF5F6B</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />

    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />

    <!-- Translucent tints used for badges and soft callouts -->
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2635D8A4" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#264C8DFF" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#26F5A623" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#26FF5F6B" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#B3000000" />

    <!-- Sidebar gradient gives the shell a little depth without a background image -->
    <LinearGradientBrush x:Key="Brush.SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141A21" Offset="0" />
        <GradientStop Color="#10141A" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
