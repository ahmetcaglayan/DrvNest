<UserControl x:Class="DrvNest.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="clr-namespace:DrvNest.App.Services"
             xmlns:vm="clr-namespace:DrvNest.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AboutViewModel}"
             d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,22">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <!-- ============================================ HEADER -->
            <StackPanel Margin="0,10,0,20">
                <TextBlock Text="{s:Loc about.title}" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{s:Loc about.subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- ============================================ IDENTITY -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56"
                            CornerRadius="14"
                            Background="{DynamicResource Brush.Accent}"
                            VerticalAlignment="Top">
                        <TextBlock Text="D"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.AccentText}" />
                    </Border>

                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProductName}" Style="{StaticResource Text.H1}" />
                            <Border Style="{StaticResource Badge}"
                                    Background="{DynamicResource Brush.AccentSoft}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Version}"
                                           Style="{StaticResource Badge.Text}"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Tagline}"
                                   Style="{StaticResource Text.Muted}"
                                   Margin="0,5,0,0" />

                        <TextBlock Text="{Binding RuntimeSummary}"
                                   Style="{StaticResource Text.Mono}"
                                   Margin="0,8,0,0" />

                        <TextBlock Text="{Binding OsSummary}"
                                   Style="{StaticResource Text.Mono}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================ UPDATER -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="{s:Loc about.checkUpdates}" Style="{StaticResource Text.H2}" />

                            <TextBlock Text="{Binding Message}"
                                       Style="{StaticResource Text.Muted}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasMessage,
                                                   Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="{Binding ReleaseTitle}"
                                       Style="{StaticResource Text.Mono}"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding ReleaseTitle,
                                                   Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Secondary}"
                                    MinWidth="190"
                                    Command="{Binding CheckCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource Icon.Sync}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{s:Loc about.checkUpdates}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Btn.Primary}"
                                    MinWidth="190"
                                    Margin="0,8,0,0"
                                    Command="{Binding DownloadCommand}"
                                    Visibility="{Binding UpdateAvailable,
                                                Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource Icon.Download}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{s:Loc about.download}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Download progress -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding IsDownloading,
                                            Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Style="{StaticResource Progress.Thick}"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding DownloadPercent, Mode=OneWay}" />

                        <TextBlock Text="{Binding DownloadText}"
                                   Style="{StaticResource Text.Mono}"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Release notes -->
                    <Border Style="{StaticResource Card.Flat}"
                            Margin="0,14,0,0"
                            Padding="14,12"
                            MaxHeight="220"
                            Visibility="{Binding HasReleaseNotes,
                                        Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{s:Loc about.releaseNotes}"
                                           Style="{StaticResource Text.Caption}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="{Binding ReleaseNotes}"
                                           Style="{StaticResource Text.Mono}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Text="{s:Loc about.checksumNote}" />
                </StackPanel>
            </Border>

            <!-- ============================================ LINKS -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding RepositoryUrl}"
                               Style="{StaticResource Text.Mono}"
                               Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Secondary}"
                                Padding="12,7"
                                Content="{s:Loc about.repo}"
                                Command="{Binding OpenRepositoryCommand}" />

                        <Button Style="{StaticResource Btn.Secondary}"
                                Padding="12,7"
                                Margin="8,0,0,0"
                                Content="{s:Loc about.issues}"
                                Command="{Binding OpenIssuesCommand}" />

                        <Button Style="{StaticResource Btn.Ghost}"
                                Padding="12,7"
                                Margin="8,0,0,0"
                                Content="{s:Loc about.releaseNotes}"
                                Command="{Binding OpenReleaseCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================ LICENSE -->
            <Border Style="{StaticResource Card.Flat}">
                <StackPanel>
                    <TextBlock Text="{s:Loc about.license}"
                               Style="{StaticResource Text.Caption}"
                               FontWeight="Bold" />
                    <TextBlock Style="{StaticResource Text.Muted}"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap"
                               Text="{s:Loc about.licenseText}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
