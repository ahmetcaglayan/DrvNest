<UserControl x:Class="DrvNest.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="clr-namespace:DrvNest.App.Services"
             xmlns:vm="clr-namespace:DrvNest.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DevicesViewModel}"
             d:DesignWidth="900">

    <UserControl.Resources>

        <!-- Filter chip. Checked state is driven by the view model, not the control. -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource Brush.TextFaint}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Class group header -->
        <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="2,14,0,8" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="22,10,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================ HEADER -->
        <Grid Grid.Row="0" Margin="0,10,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{s:Loc dev.title}" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{s:Loc dev.subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CountText}"
                           Style="{StaticResource Text.Muted}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />

                <!--
                    The same thing Device Manager's "Scan for hardware changes" does. It
                    is the one action that genuinely helps a device Windows has not
                    finished setting up, so it belongs next to the list, not buried.
                -->
                <Button Style="{StaticResource Btn.Secondary}"
                        Padding="12,7"
                        Margin="0,0,8,0"
                        Content="{s:Loc dev.rescanHardware}"
                        Command="{Binding RescanHardwareCommand}" />

                <!-- Only appears when there is genuinely something to install. -->
                <Button Style="{StaticResource Btn.Primary}"
                        Command="{Binding UpdateAllVisibleCommand}"
                        Visibility="{Binding HasUpdatable, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Update}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateAllText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================ FILTER BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <RadioButton Style="{StaticResource FilterChip}"
                             GroupName="DeviceFilter"
                             Content="{s:Loc dev.filterAll}"
                             IsChecked="{Binding IsAll, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="All" />

                <RadioButton Style="{StaticResource FilterChip}"
                             GroupName="DeviceFilter"
                             Content="{s:Loc dev.filterUpdatable}"
                             IsChecked="{Binding IsUpdatable, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Updatable" />

                <RadioButton Style="{StaticResource FilterChip}"
                             GroupName="DeviceFilter"
                             Content="{s:Loc dev.filterProblem}"
                             IsChecked="{Binding IsProblems, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Problems" />

                <RadioButton Style="{StaticResource FilterChip}"
                             GroupName="DeviceFilter"
                             Content="{s:Loc dev.filterMissing}"
                             IsChecked="{Binding IsMissing, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Missing" />

                <RadioButton Style="{StaticResource FilterChip}"
                             GroupName="DeviceFilter"
                             Content="{s:Loc dev.filterGeneric}"
                             IsChecked="{Binding IsGeneric, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Generic" />
            </StackPanel>

            <TextBox Grid.Column="1"
                     Style="{StaticResource Input.TextBox}"
                     Width="300"
                     HorizontalAlignment="Right"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                     Tag="{s:Loc common.search}"
                     ToolTip="{s:Loc common.search}" />
        </Grid>

        <!-- ============================================ NOT-CHECKED WARNING -->
        <Border Grid.Row="2"
                Style="{StaticResource Card.Flat}"
                Background="{DynamicResource Brush.WarningSoft}"
                BorderBrush="{DynamicResource Brush.Warning}"
                Padding="14,11"
                Margin="0,0,0,12"
                Visibility="{Binding SourcesUnchecked, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{StaticResource Icon.Warning}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource Brush.Warning}" />
                <TextBlock Text="{s:Loc dev.notChecked}"
                           Style="{StaticResource Text.Body}"
                           Margin="11,0,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ============================================ LIST -->
        <Grid Grid.Row="3">

            <TextBlock Text="{s:Loc dev.empty}"
                       Style="{StaticResource Text.Muted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ListBox ItemsSource="{Binding View}"
                     SelectedItem="{Binding Selected}"
                     Style="{StaticResource List.Plain}"
                     ItemContainerStyle="{StaticResource List.Row}"
                     Padding="0,0,8,16"
                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility},
                                 ConverterParameter=invert}">

                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeader}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                The real Device Manager icon for this device class, pulled
                                out of Windows by SetupDiLoadClassIcon. The lettered avatar
                                stays underneath as the fallback for classes that register
                                no icon, so a row is never blank.
                            -->
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    CornerRadius="9"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Brush.SurfaceHover}">
                                <Grid>
                                    <TextBlock Text="{Binding DeviceClass, Converter={StaticResource ClassInitial}}"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding DeviceClass, Converter={StaticResource ClassColor}}" />

                                    <Image Width="22" Height="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding ClassGuid, Converter={StaticResource ClassIcon}}" />
                                </Grid>
                            </Border>

                            <!-- Identity -->
                            <StackPanel Grid.Column="1" Margin="13,0,14,0">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource Text.Body}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />

                                <!--
                                    The version line carries the whole answer: what is
                                    installed and, when something is offered, what it would
                                    become.
                                -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                            Visibility="{Binding DriverVersion,
                                                        Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="{Binding DriverProvider}"
                                               Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="  ·  " Style="{StaticResource Text.Muted}" />
                                    <TextBlock Text="{Binding VersionSummary}"
                                               Style="{StaticResource Text.Muted}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding State,
                                                           Converter={StaticResource UpdateStateToBrush}}" />
                                    <TextBlock Text="  ·  " Style="{StaticResource Text.Muted}"
                                               Visibility="{Binding DriverDate,
                                                           Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Text="{Binding DriverDate, StringFormat=yyyy-MM-dd}"
                                               Style="{StaticResource Text.Muted}"
                                               Visibility="{Binding DriverDate,
                                                           Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>

                                <TextBlock Text="{s:Loc dev.noDriver}"
                                           Style="{StaticResource Text.Muted}"
                                           Margin="0,5,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Danger}"
                                           Visibility="{Binding DriverVersion,
                                                       Converter={StaticResource NullToVisibility},
                                                       ConverterParameter=invert}" />

                                <TextBlock Text="{Binding PrimaryHardwareId}"
                                           Style="{StaticResource Text.Mono}"
                                           Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding PrimaryHardwareId}" />

                                <TextBlock Text="{Binding Device, Converter={StaticResource ProblemToText}}"
                                           Style="{StaticResource Text.Caption}"
                                           Foreground="{Binding Health, Converter={StaticResource HealthToBrush}}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ProblemText,
                                                       Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>

                            <!-- Update state and actions -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">

                                <Border Style="{StaticResource Badge}"
                                        Background="{DynamicResource Brush.SurfaceHover}"
                                        ToolTip="{Binding StateTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding State,
                                                       Converter={StaticResource UpdateStateToBrush}}" />
                                        <TextBlock Text="{Binding StateText}"
                                                   Style="{StaticResource Badge.Text}"
                                                   Margin="7,0,0,0"
                                                   Foreground="{Binding State,
                                                               Converter={StaticResource UpdateStateToBrush}}" />
                                    </StackPanel>
                                </Border>

                                <!-- One click to install exactly this driver. -->
                                <Button Style="{StaticResource Btn.Primary}"
                                        Padding="12,6"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Right"
                                        Content="{s:Loc dev.update}"
                                        Command="{Binding InstallCommand}"
                                        Visibility="{Binding CanUpdate,
                                                    Converter={StaticResource BoolToVisibility}}" />

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,7,0,0"
                                            HorizontalAlignment="Right">

                                    <!--
                                        Shown only when no source has a package for a
                                        device that needs one. Looking the hardware id up
                                        is then the honest next step, and it is what a
                                        technician would do anyway.
                                    -->
                                    <Button Style="{StaticResource Btn.Ghost}"
                                            Padding="6,4"
                                            ToolTip="{s:Loc dev.searchOnline}"
                                            Content="{StaticResource Icon.Search}"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="13"
                                            Command="{Binding SearchOnlineCommand}"
                                            Visibility="{Binding NeedsManualHelp,
                                                        Converter={StaticResource BoolToVisibility}}" />

                                    <Button Style="{StaticResource Btn.Ghost}"
                                            Padding="6,4"
                                            Margin="2,0,0,0"
                                            ToolTip="{s:Loc dev.copyId}"
                                            Content="{StaticResource Icon.Copy}"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="13"
                                            Command="{Binding DataContext.CopyHardwareIdCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
