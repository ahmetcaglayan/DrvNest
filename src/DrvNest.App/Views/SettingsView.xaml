<UserControl x:Class="DrvNest.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="clr-namespace:DrvNest.App.Services"
             xmlns:vm="clr-namespace:DrvNest.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="900">

    <UserControl.Resources>

        <!-- Label + description on the left, control on the right. -->
        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="22,10,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================ HEADER -->
        <StackPanel Grid.Row="0" Margin="0,10,0,16">
            <TextBlock Text="{s:Loc set.title}" Style="{StaticResource Text.H1}" />
            <TextBlock Text="{s:Loc set.subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <!-- ======================================== GENERAL -->
                <TextBlock Text="{s:Loc set.general}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="{s:Loc set.parallel}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{s:Loc set.parallelHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource Input.ComboBox}"
                                      Width="92"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding ParallelOptions}"
                                      SelectedItem="{Binding MaxParallelJobs}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{s:Loc set.retries}"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,20,0" />

                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource Input.ComboBox}"
                                      Width="92"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding RetryOptions}"
                                      SelectedItem="{Binding MaxRetryAttempts}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{s:Loc set.scanOnStartup}"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,20,0" />

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Input.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ScanOnStartup}" />
                        </Grid>

                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{s:Loc set.historyRetention}"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,20,0" />

                            <TextBox Grid.Column="1"
                                     Style="{StaticResource Input.TextBox}"
                                     Width="92"
                                     VerticalAlignment="Center"
                                     Text="{Binding HistoryRetentionDays, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ======================================== SAFETY -->
                <TextBlock Text="{s:Loc set.safety}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{s:Loc set.restorePoint}"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,20,0" />

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Input.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding CreateRestorePoint}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{s:Loc set.backupBefore}"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,20,0" />

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Input.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding BackupBeforeUpdate}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{s:Loc set.resume}"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,20,0" />

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Input.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ResumeAfterReboot}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{s:Loc set.autoReboot}"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,20,0" />

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Input.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding AutoReboot}" />
                        </Grid>

                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{s:Loc set.autoRebootDelay}"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,20,0" />

                            <TextBox Grid.Column="1"
                                     Style="{StaticResource Input.TextBox}"
                                     Width="92"
                                     VerticalAlignment="Center"
                                     IsEnabled="{Binding AutoReboot}"
                                     Text="{Binding AutoRebootDelaySeconds, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ======================================== SOURCES -->
                <TextBlock Text="{s:Loc set.sources}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{s:Loc set.offline}"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,20,0" />

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Input.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding OfflineMode}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{s:Loc set.optional}"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,20,0" />

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Input.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IncludeOptionalDrivers}" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="{s:Loc set.repos}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{s:Loc set.reposHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource Btn.Secondary}"
                                    Padding="12,7"
                                    VerticalAlignment="Center"
                                    Content="{s:Loc set.addFolder}"
                                    Command="{Binding AddFolderCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RepositoryPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                            CornerRadius="7"
                                            Padding="12,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding}"
                                                       Style="{StaticResource Text.Mono}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}" />

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource Btn.Ghost}"
                                                    Padding="6,2"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource Brush.Danger}"
                                                    Content="{StaticResource Icon.Cancel}"
                                                    ToolTip="{s:Loc common.remove}"
                                                    Command="{Binding DataContext.RemoveFolderCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ======================================== APPEARANCE -->
                <TextBlock Text="{s:Loc set.appearance}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{s:Loc set.theme}"
                                       Style="{StaticResource SettingLabel}"
                                       Margin="0,0,20,0" />

                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource Input.ComboBox}"
                                      Width="150"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding Theme}" />
                        </Grid>

                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="{s:Loc set.language}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{Binding LanguageHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource Input.ComboBox}"
                                      Width="180"
                                      VerticalAlignment="Center"
                                      DisplayMemberPath="NativeName"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguage}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ======================================== DATA -->
                <Border Style="{StaticResource Card.Flat}" Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="{s:Loc set.dataFolder}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{Binding DataFolderPath}"
                                       Style="{StaticResource Text.Mono}"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource Btn.Secondary}"
                                Padding="12,7"
                                VerticalAlignment="Center"
                                Content="{s:Loc common.open}"
                                Command="{Binding OpenDataFolderCommand}" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============================================ FOOTER -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Corner.Card}"
                Padding="16,12"
                Margin="0,10,10,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Notice}"
                           Style="{StaticResource Text.Body}"
                           Foreground="{DynamicResource Brush.Accent}"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Ghost}"
                            Padding="12,7"
                            Content="{s:Loc set.reset}"
                            Command="{Binding ResetCommand}" />

                    <Button Style="{StaticResource Btn.Primary}"
                            MinWidth="120"
                            Margin="8,0,0,0"
                            Content="{s:Loc common.save}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
