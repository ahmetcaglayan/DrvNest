<Application x:Class="DrvNest.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DrvNest.App.Converters">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--
                    The palette must stay first: ThemeManager swaps this entry in place
                    when the user changes theme, and the control styles that follow
                    resolve their colours through DynamicResource.
                -->
                <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:LocalizeConverter x:Key="Localize" />
            <conv:HealthToBrushConverter x:Key="HealthToBrush" />
            <conv:HealthToTextConverter x:Key="HealthToText" />
            <conv:UpdateStateToBrushConverter x:Key="UpdateStateToBrush" />
            <conv:ProblemToTextConverter x:Key="ProblemToText" />
            <conv:JobStateToBrushConverter x:Key="JobStateToBrush" />
            <conv:JobStateToTextConverter x:Key="JobStateToText" />
            <conv:OutcomeToBrushConverter x:Key="OutcomeToBrush" />
            <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
            <conv:DeviceClassToInitialConverter x:Key="ClassInitial" />
            <conv:DeviceClassToColorConverter x:Key="ClassColor" />
            <conv:ClassGuidToIconConverter x:Key="ClassIcon" />
            <conv:ScaleConverter x:Key="Scale" />
            <conv:ThermalBandToBrushConverter x:Key="ThermalBandToBrush" />
            <conv:UpToBrushConverter x:Key="UpToBrush" />

        </ResourceDictionary>
    </Application.Resources>

</Application>
