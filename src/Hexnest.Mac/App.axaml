<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Hexnest.Mac.Converters"
             x:Class="Hexnest.Mac.App"
             Name="Hexnest"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Hexnest/Themes/Palette.axaml" />
                <ResourceInclude Source="avares://Hexnest/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:IconLookupConverter x:Key="IconLookup" />
            <conv:BytesConverter x:Key="Bytes" />
            <conv:RateConverter x:Key="Rate" />
            <conv:NotConverter x:Key="Not" />
            <conv:HasTextConverter x:Key="HasText" />
            <conv:LoadBrushConverter x:Key="LoadBrush" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!--
            Fluent underneath, the Hexnest theme on top. Fluent is doing the work no
            application should write for itself - focus adorners, scroll bar behaviour,
            text selection, keyboard navigation - and Controls.axaml then restyles the
            handful of controls Hexnest actually shows.
        -->
        <FluentTheme />
        <StyleInclude Source="avares://Hexnest/Themes/Controls.axaml" />
    </Application.Styles>

</Application>
