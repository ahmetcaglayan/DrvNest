<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Hexnest.Mac.ViewModels"
             xmlns:s="clr-namespace:Hexnest.Mac.Services"
             x:Class="Hexnest.Mac.Views.LogsView"
             x:DataType="vm:LogsViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24,20,24,24">

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Classes="h1" />
                    <TextBlock Text="{Binding Subtitle}" Classes="caption wrap" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Classes="ghost" Content="{s:Loc log.copy}" Command="{Binding CopyCommand}" />
                    <Button Classes="ghost" Content="{s:Loc log.openFolder}" Command="{Binding OpenFolderCommand}" />
                    <Button Classes="ghost" Content="{s:Loc log.clear}" Command="{Binding ClearCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding FilePath}" Classes="faint mono" Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Row="1" Classes="card" Padding="6">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:LogRow">
                            <Grid ColumnDefinitions="72,58,*" Margin="10,2">
                                <TextBlock Grid.Column="0" Text="{Binding Time}" Classes="mono faint" />
                                <TextBlock Grid.Column="1" Text="{Binding Level}" Classes="mono faint" />
                                <TextBlock Grid.Column="2" Text="{Binding Message}" Classes="mono wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>

</UserControl>
