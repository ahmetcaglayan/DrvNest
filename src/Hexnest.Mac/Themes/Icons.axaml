<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Icons, as geometry rather than as a font.

        The Windows build draws its icons from Segoe MDL2 Assets, which ships with
        Windows and is not on a Mac. The obvious substitute would be SF Symbols, but
        those live at private-use code points in a system font that is not addressable
        by name from a cross-platform toolkit, so relying on them would mean shipping
        boxes to anyone whose Mac disagreed.

        Paths have no such problem: they are part of the application, they scale to any
        display, and they tint with the palette. All of them are drawn on a 24x24 grid
        and stroked rather than filled, which keeps the weight even across the set.
    -->

    <!--
        The brand mark: the logo itself, not a stand-in.

        assets/logo.svg drawn as one stroked path on the same 24-unit grid as the rest
        of this file - the hexagonal nest cell, the chip inside it and its four pins.
        The sidebar and the About page both used the dashboard grid icon before, which
        meant the application's own badge did not match its logo anywhere.
    -->
    <StreamGeometry x:Key="Icon.Brand">M18.4,12 L15.2,17.5 L8.8,17.5 L5.6,12 L8.8,6.5 L15.2,6.5 Z M10.6,9.3 H13.4 A1.3,1.3 0 0 1 14.7,10.6 V13.4 A1.3,1.3 0 0 1 13.4,14.7 H10.6 A1.3,1.3 0 0 1 9.3,13.4 V10.6 A1.3,1.3 0 0 1 10.6,9.3 Z M10.5,4.5 V6.5 M13.5,4.5 V6.5 M10.5,17.5 V19.5 M13.5,17.5 V19.5</StreamGeometry>

    <StreamGeometry x:Key="Icon.Dashboard">M3.5,3.5 H10.5 V10.5 H3.5 Z M13.5,3.5 H20.5 V10.5 H13.5 Z M3.5,13.5 H10.5 V20.5 H3.5 Z M13.5,13.5 H20.5 V20.5 H13.5 Z</StreamGeometry>

    <StreamGeometry x:Key="Icon.System">M7,7 H17 V17 H7 Z M10,3 V7 M14,3 V7 M10,17 V21 M14,17 V21 M3,10 H7 M3,14 H7 M17,10 H21 M17,14 H21</StreamGeometry>

    <StreamGeometry x:Key="Icon.Network">M2.5,8.6 A14,14 0 0 1 21.5,8.6 M5.8,12.2 A9.4,9.4 0 0 1 18.2,12.2 M9,15.7 A4.8,4.8 0 0 1 15,15.7 M11.4,19.2 A0.9,0.9 0 1 0 12.6,19.2 A0.9,0.9 0 1 0 11.4,19.2</StreamGeometry>

    <StreamGeometry x:Key="Icon.Startup">M12,2.8 V11.5 M6.6,6.4 A7.6,7.6 0 1 0 17.4,6.4</StreamGeometry>

    <StreamGeometry x:Key="Icon.Clean">M4,20.5 L10.5,14 M9,3.5 L10.7,7.3 L14.5,9 L10.7,10.7 L9,14.5 L7.3,10.7 L3.5,9 L7.3,7.3 Z M17.5,13 L18.4,15.1 L20.5,16 L18.4,16.9 L17.5,19 L16.6,16.9 L14.5,16 L16.6,15.1 Z</StreamGeometry>

    <StreamGeometry x:Key="Icon.Logs">M4,5.5 H20 M4,10.5 H20 M4,15.5 H14.5 M4,20.5 H10</StreamGeometry>

    <StreamGeometry x:Key="Icon.Settings">M3.5,7.5 H13 M17.5,7.5 H20.5 M3.5,16.5 H7 M11.5,16.5 H20.5 M15.2,4.6 V10.4 M9.2,13.6 V19.4</StreamGeometry>

    <StreamGeometry x:Key="Icon.About">M12,3.2 A8.8,8.8 0 1 0 12.01,3.2 Z M12,11 V17 M11.4,7.6 A0.9,0.9 0 1 0 12.6,7.6 A0.9,0.9 0 1 0 11.4,7.6</StreamGeometry>

    <StreamGeometry x:Key="Icon.Shield">M12,3 L19,6 V12 C19,16.4 16,19.6 12,21 C8,19.6 5,16.4 5,12 V6 Z</StreamGeometry>

    <StreamGeometry x:Key="Icon.Refresh">M20,12 A8,8 0 1 1 17.3,6 M17.5,2.8 V6.4 H13.9</StreamGeometry>

    <StreamGeometry x:Key="Icon.Check">M4.5,12.6 L9.5,17.5 L19.5,6.5</StreamGeometry>

    <StreamGeometry x:Key="Icon.Warning">M12,3.5 L21.5,20 H2.5 Z M12,9.5 V14.5 M11.4,17.4 A0.85,0.85 0 1 0 12.6,17.4 A0.85,0.85 0 1 0 11.4,17.4</StreamGeometry>

    <StreamGeometry x:Key="Icon.Cpu">M4,17 L8,10 L11.5,15 L15,5.5 L20,17</StreamGeometry>

    <StreamGeometry x:Key="Icon.Memory">M4.5,6.5 H19.5 V17.5 H4.5 Z M8.5,6.5 V17.5 M12,6.5 V17.5 M15.5,6.5 V17.5</StreamGeometry>

    <StreamGeometry x:Key="Icon.Disk">M12,4 C16.9,4 20.5,5.4 20.5,7 V17 C20.5,18.6 16.9,20 12,20 C7.1,20 3.5,18.6 3.5,17 V7 C3.5,5.4 7.1,4 12,4 Z M3.5,7 C3.5,8.6 7.1,10 12,10 C16.9,10 20.5,8.6 20.5,7</StreamGeometry>

    <StreamGeometry x:Key="Icon.Battery">M3,7.5 H17 V16.5 H3 Z M19,10.5 V13.5</StreamGeometry>

    <StreamGeometry x:Key="Icon.Down">M12,4 V19 M5.5,12.5 L12,19 L18.5,12.5</StreamGeometry>

    <StreamGeometry x:Key="Icon.Up">M12,20 V5 M5.5,11.5 L12,5 L18.5,11.5</StreamGeometry>

</ResourceDictionary>
